<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.quark.focushelper">
    <application android:label="@string/app_name" android:allowBackup="false" android:usesCleartextTraffic="false">
        <service android:name="local.quark.focushelper.FocusService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="@string/app_name">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>
        <receiver android:name="local.quark.focushelper.ConfigReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <provider android:name="local.quark.focushelper.AgentProvider" android:authorities="local.quark.focushelper.agent" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
